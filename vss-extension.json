{
  "manifestVersion": 1,
  "id": "tictask",
  "publisher": "ghmeyer0",
  "version": "0.9.0",
  "name": "TicTask - Apontamento de Horas",
  "description": "Apontamento de horas em Tasks e User Stories com timer (iniciar/pausar/parar), Completed pela soma dos apontamentos, Remaining automático, resumo por dia, semana ou mês e calendário.",
  "public": false,
  "categories": ["Azure Boards"],
  "tags": ["time tracking", "timesheet", "apontamento", "horas"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "static/logo.png" },
  "content": { "details": { "path": "overview.md" } },
  "scopes": ["vso.work_write", "vso.project", "vso.extension.data_write"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "static", "addressable": true }
  ],
  "contributions": [
    {
      "id": "time-group",
      "type": "ms.vss-work-web.work-item-form-group",
      "description": "Botões de iniciar/pausar/parar e apontar na tela principal do work item.",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "TicTask",
        "uri": "dist/group.html",
        "height": 120
      }
    },
    {
      "id": "time-tab",
      "type": "ms.vss-work-web.work-item-form-page",
      "description": "Aba com apontamentos, tasks filhas e totais.",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "Apontamentos",
        "uri": "dist/tab.html"
      }
    },
    {
      "id": "time-hub",
      "type": "ms.vss-web.hub",
      "description": "Meu tempo, resumo e calendário (cada um vê os próprios); gestores também veem o time, Time agora e configurações.",
      "targets": ["ms.vss-work-web.work-hub-group"],
      "properties": {
        "name": "TicTask",
        "uri": "dist/hub.html",
        "iconName": "Clock",
        "order": 1
      }
    },
    {
      "id": "time-backlog-panel",
      "type": "ms.vss-work-web.backlog-panel",
      "description": "Painel lateral no backlog com o timer em andamento, o item selecionado e minhas tasks abertas.",
      "targets": ["ms.vss-work-web.requirement-backlog-toolpane", "ms.vss-work-web.iteration-backlog-toolpane"],
      "properties": {
        "title": "TicTask: timer e apontamento",
        "name": "TicTask",
        "uri": "dist/panel.html",
        "registeredObjectId": "tictaskBacklogPanel"
      }
    },
    {
      "id": "time-dialog",
      "type": "ms.vss-web.external-content",
      "description": "Diálogos de apontamento (abertos pelo host).",
      "properties": {
        "uri": "dist/dialog.html"
      }
    }
  ]
}
